<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AppEnote" parent="Theme.Material3.DayNight.NoActionBar">
        <!--Primary brand color-->
         <item name="colorPrimary">@color/primary</item>
         <item name="colorPrimaryVariant">@color/primary_light</item>
         <item name="colorOnPrimary">@color/white</item>
        <!--Secondary  brand color.-->
        <item name="colorSecondary">@color/primary_bold</item>
        <item name="colorSecondaryVariant">@color/primary_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <!--Status bar color-->
        <item name="android:statusBarColor"  tools:targetApi="l" >?attr/colorPrimaryVariant</item>
    </style>
    <style name="Base.Theme.AppEnote.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>


    <style name="Theme.AppEnote" parent="Base.Theme.AppEnote" />
    <style name="Theme.AppEnote.NoActionBar" parent="Base.Theme.AppEnote.NoActionBar" />
</resources>